{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AudioGen Response",
  "type": "object",
  "properties": {
    "answer": {
      "type": "string",
      "description": "Natural language response to the user"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "Model's confidence in the generated answer"
    },
    "sources": {
      "type": "array",
      "items": { "type": "string" },
      "description": "IDs of retrieved chunks or external references used"
    },
    "audio_url": {
      "type": "string",
      "format": "uri",
      "description": "URL to the generated audio (if any tool was called)"
    },
    "tool_call": {
      "type": "object",
      "properties": {
        "tool_name": { "type": "string" },
        "parameters": { "type": "object" },
        "status": { "type": "string", "enum": ["allowed", "blocked", "error"] }
      },
      "required": ["tool_name", "parameters", "status"]
    },
    "action": {
      "type": "string",
      "enum": ["generate_audio", "search_sounds", "clarify", "none"]
    },
    "requires_human_review": {
      "type": "boolean",
      "description": "True if the tool call is write-capable and needs user confirmation"
    },
    "error_code": {
      "type": ["string", "null"],
      "enum": [null, "missing_params", "invalid_params", "unsupported_style", "timeout", "blocked_tool"]
    }
  },
  "required": ["answer", "confidence", "action"],
  "if": {
    "properties": { "action": { "const": "generate_audio" } }
  },
  "then": {
    "required": ["audio_url", "tool_call"]
  }
}